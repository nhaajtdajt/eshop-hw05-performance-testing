                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Pick CSV row once per virtual user" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters" />
              <stringProp name="filename" />
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import org.apache.jmeter.services.FileServer
vars.put('flow_ok', 'true')
['resetToken', 'jwt', 'orderId', 'productName', 'productPrice', 'total'].each { vars.remove(it) }
if (vars.get('email') == null) {
    def base = new File(FileServer.getFileServer().getBaseDir())
    def csv = new File(base, '../data/test-users.csv')
    def lines = csv.readLines('UTF-8')
    int row = ctx.getThreadNum() + 0 + 1
    if (row &gt;= lines.size()) throw new IllegalArgumentException('Insufficient fixture rows for this group')
    def columns = lines[0].split(',', -1)
    def values = lines[row].split(',', -1)
    if (columns.length != values.length) throw new IllegalArgumentException('Invalid fixture CSV row')
    columns.eachWithIndex { column, index -&gt; vars.put(column, values[index]) }
}
</stringProp>
            </JSR223PreProcessor>
            <hashTree />
            <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Pause before next workflow" enabled="true">
              <stringProp name="ConstantTimer.delay">${__P(think_min_ms,700)}</stringProp>
              <stringProp name="RandomTimer.range">${__P(think_jitter_ms,600)}</stringProp>
            </UniformRandomTimer>
            <hashTree />
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Validate response and pass workflow data" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters" />
              <stringProp name="filename" />
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
try {
    assert prev.getResponseCode() == '200'
    def data = new JsonSlurper().parseText(prev.getResponseDataAsString())
    assert data.resetToken?.toString() ==~ /[0-9]{4,6}/; vars.put('resetToken', data.resetToken.toString())
} catch (AssertionError | Exception failure) {
    vars.put('flow_ok', 'false')
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Flow step failed: ' + prev.getSampleLabel() + ' (HTTP ' + prev.getResponseCode() + ')')
}
</stringProp>
            </JSR223Assertion>
            <hashTree />
          </hashTree>
