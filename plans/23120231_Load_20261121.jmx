                    <stringProp name="Argument.value">{"email":"${email}","resetToken":"${resetToken}","newPassword":"${newPassword}"}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
